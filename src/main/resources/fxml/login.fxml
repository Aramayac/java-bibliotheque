<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.livrehome.controller.LoginController"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-color: #f4f4f4; -fx-padding: 20;">

    <padding>
        <Insets top="40" right="20" bottom="20" left="20" />
    </padding>

    <Label text="Connexion à la Bibliothèque" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Login:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="txtLogin" promptText="Entrez votre login" GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Mot de passe:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <PasswordField fx:id="txtPassword" promptText="Entrez votre mot de passe" GridPane.rowIndex="1" GridPane.columnIndex="1" />
    </GridPane>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <CheckBox fx:id="chkRememberMe" text="Se souvenir de moi" />
        <Label fx:id="lblError" textFill="RED" style="-fx-font-weight: bold;" />
    </HBox>

    <HBox alignment="CENTER" spacing="20">
        <Button fx:id="btnLogin" text="Se connecter" onAction="#handleLogin" defaultButton="true" style="-fx-base: #4CAF50; -fx-text-fill: white;" />
    </HBox>

    <HBox alignment="CENTER">
        <Hyperlink text="Mot de passe oublié ?" onAction="#handleForgotPassword" />
    </HBox>
</VBox>
