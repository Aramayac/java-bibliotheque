<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.livrehome.controller.DashboardController"
            stylesheets="@../css/dashboard.css"
            styleClass="dashboard-root">

    <!-- ================= TOP : HEADER ================= -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="top-bar">

            <padding>
                <Insets top="15" right="25" bottom="15" left="25"/>
            </padding>

            <Label fx:id="lblBienvenue"
                   text="Bienvenue"
                   styleClass="welcome-label"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="🔄 Actualiser"
                    onAction="#handleActualiser"
                    styleClass="btn-secondary"/>

            <Button fx:id="btnDeconnexion"
                    text="🚪 Déconnexion"
                    onAction="#handleDeconnexion"
                    styleClass="btn-danger"/>
        </HBox>
    </top>

    <!-- ================= LEFT : MENU ================= -->
    <left>
        <VBox spacing="15"
              prefWidth="230"
              styleClass="side-menu">

            <padding>
                <Insets top="25" right="15" bottom="25" left="15"/>
            </padding>

            <Label text="📊 MENU"
                   styleClass="menu-title"/>

            <Button fx:id="btnLivres"
                    text="📚 Gestion Livres"
                    onAction="#handleLivres"
                    styleClass="menu-button"/>

            <Button fx:id="btnAdherents"
                    text="👥 Gestion Adhérents"
                    onAction="#handleAdherents"
                    styleClass="menu-button"/>

            <Button fx:id="btnEmprunts"
                    text="📖 Gestion Emprunts"
                    onAction="#handleEmprunts"
                    styleClass="menu-button"/>

            <Button fx:id="btnUtilisateurs"
                    text="🔐 Gestion Utilisateurs"
                    onAction="#handleUtilisateurs"
                    styleClass="menu-button"/>

        </VBox>
    </left>

    <!-- ================= CENTER : STATISTIQUES ================= -->
    <center>
        <VBox spacing="25"
              styleClass="content-area">

            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <!-- Cartes statistiques -->
            <HBox spacing="25">

                <VBox styleClass="stat-card">
                    <Label text="Total Livres" styleClass="stat-title"/>
                    <Label fx:id="lblTotalLivres" text="0" styleClass="stat-value"/>
                </VBox>

                <VBox styleClass="stat-card">
                    <Label text="Total Adhérents" styleClass="stat-title"/>
                    <Label fx:id="lblTotalAdherents" text="0" styleClass="stat-value"/>
                </VBox>

                <VBox styleClass="stat-card">
                    <Label text="Emprunts en cours" styleClass="stat-title"/>
                    <Label fx:id="lblEmpruntsEnCours" text="0" styleClass="stat-value"/>
                </VBox>

                <VBox styleClass="stat-card alert-card">
                    <Label text="Emprunts en retard" styleClass="stat-title"/>
                    <Label fx:id="lblEmpruntsRetard" text="0" styleClass="stat-value alert-text"/>
                </VBox>

            </HBox>

            <!-- Liste des retards -->
            <VBox spacing="10">

                <Label text="⚠️ Liste des retards"
                       styleClass="section-title"/>

                <ListView fx:id="listRetards"
                          prefHeight="250"
                          styleClass="modern-list"/>

            </VBox>

        </VBox>
    </center>

</BorderPane>
