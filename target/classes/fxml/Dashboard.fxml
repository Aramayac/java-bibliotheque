<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Pos?>

<HBox fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="900.0" prefWidth="1400.0" styleClass="root" stylesheets="@/css/style.css"
      xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.livreshome.controller.DashboardController"
>

    <children>
        <!-- SIDEBAR LEFT -->
        <VBox prefHeight="900.0" prefWidth="280.0" styleClass="sidebar" stylesheets="@/css/style.css">
            <children>
                <!-- Logo Section -->
                <AnchorPane prefHeight="100.0" prefWidth="280.0" styleClass="logo-section"
                            stylesheets="@/css/style.css">
                    <children>
                        <Label layoutX="30.0" layoutY="30.0" text="📚 Biblio_Z_221" textFill="#FFFFFF">
                            <font>
                                <Font name="Segoe UI Bold" size="24.0"/>
                            </font>
                        </Label>
                        <Label layoutX="30.0" layoutY="60.0" text="v1.0.0" textFill="#B0B8D4">
                            <font>
                                <Font name="Segoe UI" size="10.0"/>
                            </font>
                        </Label>
                    </children>
                </AnchorPane>

                <!-- Navigation Buttons -->
                <ScrollPane fitToWidth="true" prefHeight="600.0" prefWidth="280.0"
                            style="-fx-background: transparent; -fx-border-color: transparent;">
                    <VBox>
                        <children>
                            <VBox spacing="15.0" style="-fx-background-color: transparent;" prefWidth="260.0">
                                <padding>
                                    <Insets top="20.0" left="15.0" right="15.0" bottom="20.0"/>
                                </padding>
                                <children>
                                    <!-- Dashboard Button -->
                                    <JFXButton fx:id="btnDashboard" onAction="#onDashboardClicked" prefHeight="45.0"
                                               prefWidth="250.0"
                                               styleClass="nav-button-active" stylesheets="@/css/style.css"
                                               text="📊 Tableau de Bord" textFill="#FFFFFF">
                                        <font>
                                            <Font name="Segoe UI SemiBold" size="13.0"/>
                                        </font>
                                    </JFXButton>

                                    <!-- Books Button -->
                                    <JFXButton fx:id="btnBooks" onAction="#onBooksClicked" prefHeight="45.0"
                                               prefWidth="250.0"
                                               styleClass="nav-button" stylesheets="@/css/style.css"
                                               text="📖 Gestion des Livres" textFill="#B0B8D4">
                                        <font>
                                            <Font name="Segoe UI SemiBold" size="13.0"/>
                                        </font>
                                    </JFXButton>

                                    <!-- Members Button -->
                                    <JFXButton fx:id="btnMembers" onAction="#onMembersClicked" prefHeight="45.0"
                                               prefWidth="250.0"
                                               styleClass="nav-button" stylesheets="@/css/style.css"
                                               text="👥 Gestion des Adhérents" textFill="#B0B8D4">
                                        <font>
                                            <Font name="Segoe UI SemiBold" size="13.0"/>
                                        </font>
                                    </JFXButton>

                                    <!-- Loans Button -->
                                    <JFXButton fx:id="btnLoans" onAction="#onLoansClicked" prefHeight="45.0"
                                               prefWidth="250.0"
                                               styleClass="nav-button" stylesheets="@/css/style.css"
                                               text="🔄 Gestion des Emprunts" textFill="#B0B8D4">
                                        <font>
                                            <Font name="Segoe UI SemiBold" size="13.0"/>
                                        </font>
                                    </JFXButton>

                                    <!-- Users Management Button (Admin Only) -->
                                    <JFXButton fx:id="btnUsers" onAction="#onUsersClicked" prefHeight="45.0"
                                               prefWidth="250.0"
                                               styleClass="nav-button" stylesheets="@/css/style.css"
                                               text="⚙️ Gestion des Utilisateurs" textFill="#B0B8D4">
                                        <font>
                                            <Font name="Segoe UI SemiBold" size="13.0"/>
                                        </font>
                                    </JFXButton>

                                    <!-- Statistics Button -->
                                    <JFXButton fx:id="btnStatistics" onAction="#onStatisticsClicked" prefHeight="45.0"
                                               prefWidth="250.0"
                                               styleClass="nav-button" stylesheets="@/css/style.css"
                                               text="📈 Statistiques" textFill="#B0B8D4">
                                        <font>
                                            <Font name="Segoe UI SemiBold" size="13.0"/>
                                        </font>
                                    </JFXButton>

                                    <!-- Settings Button -->
                                    <JFXButton fx:id="btnSettings" onAction="#onSettingsClicked" prefHeight="45.0"
                                               prefWidth="250.0"
                                               styleClass="nav-button" stylesheets="@/css/style.css" text="🔧 Paramètres"
                                               textFill="#B0B8D4">
                                        <font>
                                            <Font name="Segoe UI SemiBold" size="13.0"/>
                                        </font>
                                    </JFXButton>
                                </children>
                            </VBox>
                        </children>
                    </VBox>
                </ScrollPane>

                <!-- User Profile Section -->
                <AnchorPane prefHeight="100.0" prefWidth="280.0" styleClass="user-profile-section"
                            stylesheets="@/css/style.css">
                    <children>
                        <Label fx:id="lblUserName" layoutX="60.0" layoutY="20.0" text="Admin User" textFill="#FFFFFF">
                            <font>
                                <Font name="Segoe UI SemiBold" size="12.0"/>
                            </font>
                        </Label>
                        <Label fx:id="lblUserRole" layoutX="60.0" layoutY="40.0" text="Administrateur"
                               textFill="#B0B8D4">
                            <font>
                                <Font name="Segoe UI" size="10.0"/>
                            </font>
                        </Label>
                        <JFXButton fx:id="btnLogout" layoutX="200.0" layoutY="25.0" onAction="#onLogoutClicked"
                                   prefHeight="35.0" prefWidth="60.0"
                                   styleClass="logout-button" stylesheets="@/css/style.css" text="🚪" textFill="#FFFFFF">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </JFXButton>
                    </children>
                </AnchorPane>
            </children>
        </VBox>

        <!-- MAIN CONTENT AREA -->
        <VBox prefHeight="900.0" prefWidth="1120.0" spacing="0" style="-fx-background-color: #F5F7FB;">
            <children>
                <!-- TOP BAR -->
                <HBox prefHeight="80.0" prefWidth="1120.0" spacing="20.0"
                      style="-fx-background-color: #FFFFFF; -fx-border-color: #E8EDF5; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets top="15.0" right="30.0" bottom="15.0" left="30.0"/>
                    </padding>
                    <children>
                        <!-- Search Bar -->
                        <JFXTextField fx:id="searchField" focusColor="#4A6FA5" promptText="🔍 Rechercher..."
                                      unFocusColor="#B0B8D4"
                                      prefHeight="45.0" prefWidth="350.0" stylesheets="@/css/style.css">
                            <font>
                                <Font name="Segoe UI" size="12.0"/>
                            </font>
                        </JFXTextField>

                        <!-- Spacer -->
                        <Pane HBox.hgrow="ALWAYS"/>

                        <!-- Notifications Button -->
                        <JFXButton prefHeight="45.0" prefWidth="45.0" styleClass="icon-button"
                                   stylesheets="@/css/style.css"
                                   text="🔔" textFill="#4A6FA5">
                            <font>
                                <Font size="18.0"/>
                            </font>
                        </JFXButton>

                        <!-- Profile Button -->
                        <JFXButton prefHeight="45.0" prefWidth="45.0" styleClass="icon-button"
                                   stylesheets="@/css/style.css"
                                   text="👤" textFill="#4A6FA5">
                            <font>
                                <Font size="18.0"/>
                            </font>
                        </JFXButton>
                    </children>
                </HBox>

                <!-- MAIN CONTENT SCROLLPANE -->
                <ScrollPane fitToWidth="true" prefHeight="820.0" prefWidth="1120.0"
                            style="-fx-background: transparent; -fx-border-color: transparent;">
                    <VBox>
                    <children>
                        <VBox spacing="25.0" style="-fx-background-color: transparent;" prefWidth="1090.0">
                            <padding>
                                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
                            </padding>
                            <children>
                                <!-- Welcome Section -->
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Bienvenue dans BiblioMax" textFill="#1F2937">
                                            <font>
                                                <Font name="Segoe UI Bold" size="28.0"/>
                                            </font>
                                        </Label>
                                        <Label text="Gérez votre bibliothèque municipale efficacement et en toute sérénité"
                                               textFill="#6B7280">
                                            <font>
                                                <Font name="Segoe UI" size="13.0"/>
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <!-- KPI Cards Row 1 -->
                                <HBox spacing="20.0" prefWidth="1090.0">
                                    <children>
                                        <!-- Total Books Card -->
                                        <Pane prefHeight="140.0" prefWidth="260.0" styleClass="kpi-card"
                                              stylesheets="@/css/style.css">
                                            <children>
                                                <Label layoutX="20.0" layoutY="15.0" text="📚 Livres Total"
                                                       textFill="#6B7280">
                                                    <font>
                                                        <Font name="Segoe UI SemiBold" size="12.0"/>
                                                    </font>
                                                </Label>
                                                <Label fx:id="lblTotalBooks" layoutX="20.0" layoutY="35.0" text="2,450"
                                                       textFill="#1F2937">
                                                    <font>
                                                        <Font name="Segoe UI Bold" size="32.0"/>
                                                    </font>
                                                </Label>
                                                <Label layoutX="20.0" layoutY="95.0"
                                                       text="↑ 12.5% depuis le mois dernier" textFill="#10B981">
                                                    <font>
                                                        <Font name="Segoe UI" size="11.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </Pane>

                                        <!-- Total Members Card -->
                                        <Pane prefHeight="140.0" prefWidth="260.0" styleClass="kpi-card"
                                              stylesheets="@/css/style.css">
                                            <children>
                                                <Label layoutX="20.0" layoutY="15.0" text="👥 Adhérents"
                                                       textFill="#6B7280">
                                                    <font>
                                                        <Font name="Segoe UI SemiBold" size="12.0"/>
                                                    </font>
                                                </Label>
                                                <Label fx:id="lblTotalMembers" layoutX="20.0" layoutY="35.0"
                                                       text="1,834" textFill="#1F2937">
                                                    <font>
                                                        <Font name="Segoe UI Bold" size="32.0"/>
                                                    </font>
                                                </Label>
                                                <Label layoutX="20.0" layoutY="95.0"
                                                       text="↑ 8.2% depuis le mois dernier" textFill="#10B981">
                                                    <font>
                                                        <Font name="Segoe UI" size="11.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </Pane>

                                        <!-- Active Loans Card -->
                                        <Pane prefHeight="140.0" prefWidth="260.0" styleClass="kpi-card"
                                              stylesheets="@/css/style.css">
                                            <children>
                                                <Label layoutX="20.0" layoutY="15.0" text="🔄 Emprunts Actifs"
                                                       textFill="#6B7280">
                                                    <font>
                                                        <Font name="Segoe UI SemiBold" size="12.0"/>
                                                    </font>
                                                </Label>
                                                <Label fx:id="lblActiveLoans" layoutX="20.0" layoutY="35.0" text="567"
                                                       textFill="#1F2937">
                                                    <font>
                                                        <Font name="Segoe UI Bold" size="32.0"/>
                                                    </font>
                                                </Label>
                                                <Label layoutX="20.0" layoutY="95.0"
                                                       text="↑ 23.1% depuis le mois dernier" textFill="#10B981">
                                                    <font>
                                                        <Font name="Segoe UI" size="11.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </Pane>

                                        <!-- Overdue Books Card -->
                                        <Pane prefHeight="140.0" prefWidth="260.0" styleClass="kpi-card-warning"
                                              stylesheets="@/css/style.css">
                                            <children>
                                                <Label layoutX="20.0" layoutY="15.0" text="⚠️ Retards"
                                                       textFill="#6B7280">
                                                    <font>
                                                        <Font name="Segoe UI SemiBold" size="12.0"/>
                                                    </font>
                                                </Label>
                                                <Label fx:id="lblOverdueBooks" layoutX="20.0" layoutY="35.0" text="42"
                                                       textFill="#DC2626">
                                                    <font>
                                                        <Font name="Segoe UI Bold" size="32.0"/>
                                                    </font>
                                                </Label>
                                                <Label layoutX="20.0" layoutY="95.0" text="À traiter d'urgence"
                                                       textFill="#DC2626">
                                                    <font>
                                                        <Font name="Segoe UI" size="11.0"/>
                                                    </font>
                                                </Label>
                                            </children>
                                        </Pane>
                                    </children>
                                </HBox>

                                <!-- Charts and Tables Row -->
                                <HBox spacing="20.0" prefWidth="1090.0" prefHeight="350.0">
                                    <children>
                                        <!-- Monthly Loans Chart -->
                                        <Pane prefHeight="350.0" prefWidth="540.0" styleClass="chart-card"
                                              stylesheets="@/css/style.css">
                                            <children>
                                                <Label layoutX="20.0" layoutY="15.0" text="📊 Emprunts du mois"
                                                       textFill="#1F2937">
                                                    <font>
                                                        <Font name="Segoe UI SemiBold" size="14.0"/>
                                                    </font>
                                                </Label>
                                                <BarChart layoutX="10.0" layoutY="50.0" prefHeight="280.0"
                                                          prefWidth="520.0">
                                                    <xAxis>
                                                        <CategoryAxis side="BOTTOM"/>
                                                    </xAxis>
                                                    <yAxis>
                                                        <NumberAxis side="LEFT"/>
                                                    </yAxis>
                                                </BarChart>
                                            </children>
                                        </Pane>

                                        <!-- Top Borrowed Books -->
                                        <Pane prefHeight="350.0" prefWidth="540.0" styleClass="list-card"
                                              stylesheets="@/css/style.css">
                                            <children>
                                                <Label layoutX="20.0" layoutY="15.0" text="🏆 Livres les plus empruntés"
                                                       textFill="#1F2937">
                                                    <font>
                                                        <Font name="Segoe UI SemiBold" size="14.0"/>
                                                    </font>
                                                </Label>
                                                <ScrollPane layoutX="10.0" layoutY="50.0" prefHeight="280.0"
                                                            prefWidth="520.0"
                                                            style="-fx-background: transparent; -fx-border-color: transparent;">
                                                    <VBox>
                                                    <children>
                                                        <VBox spacing="10.0" prefWidth="500.0"
                                                              style="-fx-background-color: transparent;">
                                                            <padding>
                                                                <Insets top="5.0" left="10.0" right="10.0"
                                                                        bottom="5.0"/>
                                                            </padding>
                                                        </VBox>
                                                    </children>
                                                    </VBox>
                                                </ScrollPane>
                                            </children>
                                        </Pane>
                                    </children>
                                </HBox>

                                <!-- Recent Transactions Table -->
                                <Pane prefHeight="300.0" prefWidth="1090.0" styleClass="table-card"
                                      stylesheets="@/css/style.css">
                                    <children>
                                        <Label layoutX="20.0" layoutY="15.0" text="📋 Transactions Récentes"
                                               textFill="#1F2937">
                                            <font>
                                                <Font name="Segoe UI SemiBold" size="14.0"/>
                                            </font>
                                        </Label>
                                        <TableView layoutX="10.0" layoutY="50.0" prefHeight="230.0" prefWidth="1070.0">
                                            <columns>
                                                <TableColumn prefWidth="180.0" text="Date"/>
                                                <TableColumn prefWidth="200.0" text="Adhérent"/>
                                                <TableColumn prefWidth="250.0" text="Titre du Livre"/>
                                                <TableColumn prefWidth="150.0" text="Type"/>
                                                <TableColumn prefWidth="150.0" text="Statut"/>
                                            </columns>
                                        </TableView>
                                    </children>
                                </Pane>
                            </children>
                        </VBox>
                    </children>
                    </VBox>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</HBox>